generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                       @id @default(autoincrement())
  email                   String                    @unique(map: "email") @db.VarChar(40)
  password                String                    @db.VarChar(60)
  name                    String?                   @db.VarChar(10)
  nickname                String?                   @db.VarChar(10)
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime?                 @updatedAt @map("updated_at")
  isCompleted             Boolean                   @default(false) @map("is_completed")
  refreshToken         RefreshToken[]
  
  surveys   Survey[]
  libraries Library[]

  @@map("user")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @db.Text
  userId    Int       @map("user_id")
  updatedAt DateTime? @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}

model Book{
  isbn        String  @id
  title       String  @db.VarChar(255)
  publisher   String  @db.VarChar(255)
  description String? @db.Text 
  page        Int?
  main_category  String @db.VarChar(255)
  averageRate Float?
  image       String? @db.VarChar(255)
  authors     String[]
  categories  String[]

  // Relations
  // authors         Author[]
  // libraries       Library[]
  // categoryEntries Category[]

  @@map("book")
}

model Survey {
  id       Int     @id @default(autoincrement())
  userId   Int     @unique @map("user_id")
  amount   Int?    @map("amount") 
  style String 
  category String[] 

  // Relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //@@id([id, userId])
  @@map("survey")
}

model Library{
  id      Int     @id @default(autoincrement())
  userId  Int     @map("user_id")
  isbn    String
  count   Int     @default(0)
  isRead  Boolean? @map("is_read")
  isRecom Boolean? @map("is_recom")
  created_at DateTime? @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // book Book @relation(fields: [isbn], references: [isbn], onDelete: Cascade)

  //@@id([id, userId, isbn])
  @@map("library")
}

